# Copy to ~/.config/hermes-webhook-relay/env (or set RELAY_ENV_FILE), readable
# only by you: chmod 600. Variables set in the environment take precedence.

# The queue's HTTP pull consumer. The token needs Account > Queues > Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_QUEUE_ID=
CLOUDFLARE_QUEUES_TOKEN=

# Read by `show`, for each provider you use.
GRANOLA_API_KEY=
POCKET_API_KEY=

# Where the inbox lives. Default: ~/.local/state/hermes-webhook-relay/inbox.sqlite
# RELAY_INBOX=
