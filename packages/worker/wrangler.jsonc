{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-webhook-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "queues": {
    "producers": [
      { "binding": "EVENTS", "queue": "hermes-webhook-events" }
    ]
  }
