{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  // Workers globals come from the generated worker-configuration.d.ts, not an @types package.
  "include": ["src", "test", "worker-configuration.d.ts"],
  "references": [{ "path": "../envelope" }],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    // Nothing imports the worker, so it is type-checked without emitting declarations.
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  }
}
